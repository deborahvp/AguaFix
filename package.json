  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "typeorm": "typeorm -d dist/config/database.config.js",
    "migration:generate": "npm run build && npm run typeorm migration:generate",
